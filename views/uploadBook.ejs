<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PanaGhar - Upload Book</title>
    <link rel="stylesheet" href="style.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
      integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-white font-sans">
    <div class="h-[100vh] flex">
      <!-- Sidebar -->
      <aside
        id="sidebar"
        class="w-full lg:w-[350px] h-full bg-[#efeeee] border-r border-[#868686] p-6 transform transition-all duration-300 ease-in-out -translate-x-full lg:translate-x-0 fixed lg:static  z-50"
      >
        <!-- Logo -->
        <img
          src="assets/green_logo.png"
          alt="Logo"
          class="mb-6 max-w-full h-auto"
        />
        <nav class="space-y-2">
          <a
            href="/dashboard"
            class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-[#88965E80] text-[#52525B] font-semibold text-[17.5px]"
          >
            <i class="fa-solid fa-users"></i> Dashboard
          </a>
          <a
            href="/upload"
            class="flex items-center gap-3 px-4 py-3 rounded-lg bg-[#88965E80] text-[#52525B] font-semibold text-[17.5px]"
          >
            <i class="fa-solid fa-arrow-up-from-bracket"></i> Upload Books
          </a>
          <a
            href="/manageBook"
            class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-[#88965E80] text-[#52525B] font-semibold text-[17.5px]"
          >
            <i class="fa-solid fa-book"></i> Manage Books
          </a>
          <a
            href="/payment"
            class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-[#88965E80] text-[#52525B] font-semibold text-[17.5px]"
          >
            <i class="fa-solid fa-box"></i> Payments
          </a>
          <a
            href="/login"
            class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-[#88965E80] text-[#FF3D00] font-semibold text-[17.5px]"
          >
            <i class="fa-solid fa-right-from-bracket"></i> Logout
          </a>
        </nav>
      </aside>

      <!-- Mobile Hamburger & Close Icons -->
      <button id="hamburger-btn" class="lg:hidden fixed top-4 left-4 z-40 p-4">
        <i class="fa-solid fa-bars text-[#324A16] text-2xl"></i>
      </button>
      <button id="close-btn" class="lg:hidden fixed top-4 left-4 z-50 p-4 hidden">
        <i class="fa-solid fa-xmark text-[#324A16] text-2xl"></i>
      </button>

      <!-- Main Content -->
      <div class="flex-1 p-6 lg:p-10">
        <!-- Error/Success Messages -->
        <% if (error) { %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
          <%= error %>
        </div>
        <% } %>
        <% if (success) { %>
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
          <%= success %>
        </div>
        <% } %>

        <!-- Book Upload Form -->
        <form
          action="/upload"
          method="POST"
          enctype="multipart/form-data"
          class="font-['Inter']"
        >
          <div class="flex justify-between items-center  mb-8">
            <h1 class="text-[32px] font-semibold text-[#1b1b1b]">Upload Books</h1>
            <button
              type="submit"
              class="bg-[#324A16] text-white rounded-[8px] h-[44px] px-6 flex items-center justify-center hover:bg-[#4f623a] transition"
            >
              Upload
            </button>
          </div>

          <!-- Form Grid -->
          <div class="grid gap-x-10 gap-y-7 grid-cols-1 lg:grid-cols-2">
            <!-- Book Name -->
            <div>
              <label for="bookName" class="block text-base mb-1 font-medium text-[#283618]">
                Book Name <span class="text-red-600">*</span>
              </label>
              <input
                id="bookName"
                name="bookName"
                type="text"
                required
                placeholder="Enter book title"
                class="w-full border border-[#88965E] rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-[#324A16]"
              />
            </div>

            <!-- Genre -->
            <div>
              <label for="bookGenre" class="block text-base mb-1 font-medium text-[#283618]">
                Book Genre <span class="text-red-600">*</span>
              </label>
              <select
                id="bookGenre"
                name="genre"
                required
                class="w-full border border-[#88965E] rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-[#324A16]"
              >
                <option value="" disabled selected>Select a genre</option>
                <option value="Fiction">Fiction</option>
                <option value="Non fiction">Non-fiction</option>
                <option value="Horror">Horror</option>
                <option value="Psychology">Psychology</option>
                <option value="Children">Children</option>
                <option value="History">History</option>
              </select>
            </div>

            <!-- Author -->
            <div>
              <label for="author" class="block text-base mb-1 font-medium text-[#283618]">
                Author <span class="text-red-600">*</span>
              </label>
              <input
                id="author"
                name="author"
                type="text"
                required
                placeholder="Enter author name"
                class="w-full border border-[#88965E] rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-[#324A16]"
              />
            </div>

            <!-- Condition -->
            <div>
              <label for="condition" class="block text-base mb-1 font-medium text-[#283618]">
                Condition <span class="text-red-600">*</span>
              </label>
              <select
                id="condition"
                name="condition"
                required
                class="w-full border border-[#88965E] rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-[#324A16]"
              >
                <option value="" disabled selected>Select condition</option>
                <option value="Excellent">Excellent</option>
                <option value="Good">Good</option>
                <option value="Average">Average</option>
                <option value="Bad">Bad</option>
              </select>
            </div>

            <!-- Description -->
            <div class="lg:col-span-2">
              <label for="description" class="block text-base mb-1 font-medium text-[#283618]">
                Description <span class="text-red-600">*</span>
              </label>
              <textarea
                id="description"
                name="description"
                rows="6"
                required
                placeholder="Enter book description..."
                class="w-full border border-[#88965E] bg-[#f9f9f9] rounded-lg px-4 py-3 text-sm resize-none focus:outline-none focus:ring-2 focus:ring-[#324A16]"
              ></textarea>
            </div>

            <!-- Images Upload -->
            <div class="lg:col-span-2">
              <label class="block text-base mb-3 font-medium text-[#283618]">
                Upload Book Images <span class="text-red-600">*</span>
              </label>
              <input
                type="file"
                name="images"
                id="imageUpload"
                accept="image/*"
                multiple
                required
                class="block w-full mt-2 text-sm text-gray-600 file:mr-4 file:py-2 file:px-4 file:border-0 file:text-sm file:bg-[#81a15d] file:text-white hover:file:bg-[#6e8d4a] rounded cursor-pointer"
              />
              <p class="text-xs text-gray-500 mt-1">Upload up to 4 images (front, back, spine, side)</p>
              
              <!-- Image Preview -->
              <div id="imagePreview" class="grid grid-cols-4 gap-4 mt-4 hidden">
                <!-- Preview images will appear here -->
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>

    <script src="script.js"></script>
    <script>
      // Sidebar toggle for mobile
      const sidebar = document.getElementById('sidebar');
      const hamburgerBtn = document.getElementById('hamburger-btn');
      const closeBtn = document.getElementById('close-btn');

      hamburgerBtn?.addEventListener('click', () => {
        sidebar.classList.remove('-translate-x-full');
        hamburgerBtn.classList.add('hidden');
        closeBtn.classList.remove('hidden');
      });

      closeBtn?.addEventListener('click', () => {
        sidebar.classList.add('-translate-x-full');
        closeBtn.classList.add('hidden');
        hamburgerBtn.classList.remove('hidden');
      });

      // Image preview functionality
      const imageUpload = document.getElementById('imageUpload');
      const imagePreview = document.getElementById('imagePreview');

      imageUpload.addEventListener('change', function() {
        imagePreview.innerHTML = '';
        const files = Array.from(this.files);
        
        if (files.length > 0) {
          imagePreview.classList.remove('hidden');
          
          files.slice(0, 4).forEach(file => {
            const reader = new FileReader();
            reader.onload = function(e) {
              const div = document.createElement('div');
              div.className = 'relative';
              div.innerHTML = `
                <img src="${e.target.result}" class="w-full h-32 object-cover rounded-lg border-2 border-[#88965E]" />
              `;
              imagePreview.appendChild(div);
            };
            reader.readAsDataURL(file);
          });
        } else {
          imagePreview.classList.add('hidden');
        }
      });
    </script>
  </body>
</html>