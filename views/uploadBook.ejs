<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PanaGhar Login</title>
    <link rel="stylesheet" href="style.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
      integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-white font-sans">
    <div class="h-[125vh] flex">
      <!-- Sidebar -->
      <aside
        id="sidebar"
        class="w-full lg:w-[350px] bg-[#efeeee] border-r border-[#868686] p-6 lg:relative transform transition-all duration-300 ease-in-out -translate-x-full lg:translate-x-0"
      >
        <!-- Logo -->
        <img
          src="assets/green_logo.png"
          alt="Logo"
          class="mb-6 max-w-full h-auto"
        />
        <nav class="space-y-2">
          <a
            href="/dashboard"
            class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-[#88965E80] text-[#52525B] font-semibold text-[17.5px]"
          >
            <i class="fa-solid fa-users"></i> Dashboard
          </a>
          <a
            href="/upload"
            class="flex items-center gap-3 px-4 py-3 rounded-lg bg-[#88965E80] text-[#52525B] font-semibold text-[17.5px]"
          >
            <i class="fa-solid fa-arrow-up-from-bracket"></i> Upload Books
          </a>
          <a
            href="/manageBook"
            class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-[#88965E80] text-[#52525B] font-semibold text-[17.5px]"
          >
            <i class="fa-solid fa-book"></i> Manage Books
          </a>
          <a
            href="/payment"
            class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-[#88965E80] text-[#52525B] font-semibold text-[17.5px]"
          >
            <i class="fa-solid fa-box"></i> Payments
          </a>
          <a
            href="/login"
            class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-[#88965E80] text-[#FF3D00] font-semibold text-[17.5px]"
          >
            <i class="fa-solid fa-right-from-bracket"></i> Logout
          </a>
        </nav>
      </aside>

      <!-- Mobile Hamburger Icon -->
      <button id="hamburger-btn" class="lg:hidden p-4">
        <i class="fa-solid fa-bars text-[#324A16] text-2xl"></i>
      </button>

      <!-- Mobile Close Icon -->
      <button id="close-btn" class="lg:hidden p-4 hidden">
        <i class="fa-solid fa-xmark text-[#324A16] text-2xl"></i>
      </button>
      <!-- Entry-->
      <div class="font-['Inter'] mt-[55px] ml-[70px] pr-[3rem]">
        <!-- Top section -->
        <div class="flex justify-between items-center mb-[3.5rem]">
          <h1 class="text-[32px] font-semibold text-[#1b1b1b]">Upload Books</h1>
        </div>
       

        <!-- Book Upload Form -->
<form
  action="/upload"
  method="POST"
  enctype="multipart/form-data"
  class="font-['Inter'] mt-[55px] ml-[70px] pr-[3rem]"
>
  <div class="flex justify-between items-center mb-[3.5rem]">
    <h1 class="text-[32px] font-semibold text-[#1b1b1b]">Upload Books</h1>
    <button
      type="submit"
      class="bg-[#324A16] text-white rounded-[8px] h-[44px] w-[98px] flex items-center justify-center hover:bg-[#4f623a] transition"
    >
      Upload
    </button>
  </div>

  <!-- Form Grid -->
  <div class="grid gap-x-10 gap-y-7 grid-cols-1 lg:grid-cols-2">
    <!-- Book Name -->
    <div>
      <label for="bookName" class="block text-base mb-1 font-medium text-[#283618]">
        Book Name <span class="text-red-600">*</span>
      </label>
      <input
        id="bookName"
        name="bookName"
        type="text"
        required
        class="w-full border border-[#88965E] rounded px-4 py-2"
      />
    </div>

    <!-- Genre -->
    <div>
      <label for="bookGenre" class="block text-base mb-1 font-medium text-[#283618]">
        Book Genre <span class="text-red-600">*</span>
      </label>
      <select
        id="bookGenre"
        name="genre"
        required
        class="w-full border border-[#88965E] rounded px-4 py-2"
      >
        <option value="" disabled selected>Select a genre</option>
        <option value="fiction">Fiction</option>
        <option value="non-fiction">Non-Fiction</option>
        <option value="fantasy">Fantasy</option>
        <option value="mystery">Mystery</option>
        <option value="thriller">Thriller</option>
        <option value="romance">Romance</option>
        <option value="science-fiction">Science Fiction</option>
        <option value="biography">Biography</option>
        <option value="history">History</option>
      </select>
    </div>

    <!-- Author -->
    <div>
      <label for="author" class="block text-base mb-1 font-medium text-[#283618]">
        Author <span class="text-red-600">*</span>
      </label>
      <input
        id="author"
        name="author"
        type="text"
        required
        class="w-full border border-[#88965E] rounded px-4 py-2"
      />
    </div>

    <!-- Condition -->
    <div>
      <label for="condition" class="block text-base mb-1 font-medium text-[#283618]">
        Condition <span class="text-red-600">*</span>
      </label>
      <select
        id="condition"
        name="condition"
        required
        class="w-full border border-[#88965E] rounded px-4 py-2"
      >
        <option value="" disabled selected>Select condition</option>
        <option value="new">New</option>
        <option value="like-new">Like New</option>
        <option value="very-good">Very Good</option>
        <option value="good">Good</option>
        <option value="fair">Fair</option>
        <option value="poor">Poor</option>
      </select>
    </div>

    <!-- Description -->
    <div class="lg:col-span-2">
      <label for="description" class="block text-base mb-1 font-medium text-[#283618]">
        Description <span class="text-red-600">*</span>
      </label>
      <textarea
        id="description"
        name="description"
        rows="6"
        required
        class="w-full border border-[#88965E] bg-[#f9f9f9] rounded-lg px-4 py-3 text-sm resize-none"
      ></textarea>
    </div>

    <!-- Images Upload -->
    <div class="lg:col-span-2">
      <label class="block text-base mb-3 font-medium text-[#283618]">
        Upload Book Images <span class="text-red-600">*</span>
      </label>
      <input
        type="file"
        name="images"
        accept="image/*"
        multiple
        required
        class="block w-full mt-2 text-sm text-gray-600 file:mr-4 file:py-2 file:px-4 file:border-0 file:text-sm file:bg-[#81a15d] file:text-white hover:file:bg-[#6e8d4a] rounded"
      />
      <p class="text-xs text-gray-500 mt-1">Upload up to 4 images (front, back, spine, side)</p>
    </div>
  </div>
</form>

        <!-- Edit Button -->
        <button
          id="editBtn"
          class="bg-[#324A16] text-white rounded-[8px] h-[44px] w-[98px] flex items-center justify-center mt-[40px] ml-[910px] hover:bg-[#4f623a] transition"
        >
          Edit
        </button>
      </div>
    </div>
  </body>
  <script src="script.js"></script>
  <script>
    function previewImage(inputId, imgId, labelId) {
      const input = document.getElementById(inputId);
      const img = document.getElementById(imgId);
      const label = document.getElementById(labelId);

      input.addEventListener("change", function () {
        const file = this.files[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = function (e) {
            img.src = e.target.result;
            img.classList.remove("hidden");
            label.classList.add("hidden");
          };
          reader.readAsDataURL(file);
        }
      });
    }

    window.onload = function () {
      previewImage("frontUpload", "frontImage", "frontLabel");
      previewImage("backUpload", "backImage", "backLabel");
      previewImage("spineUpload", "spineImage", "spineLabel");
      previewImage("sideUpload", "sideImage", "sideLabel");

      const editBtn = document.getElementById("editBtn");
      editBtn.addEventListener("click", function () {
        document.getElementById("frontLabel").classList.remove("hidden");
        document.getElementById("backLabel").classList.remove("hidden");
        document.getElementById("spineLabel").classList.remove("hidden");
        document.getElementById("sideLabel").classList.remove("hidden");
      });
    };
    
  </script>
</html>