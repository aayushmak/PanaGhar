<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PanaGhar Login</title>
    <link rel="stylesheet" href="/styles/style.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter&family=Poppins&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-white font-['Inter']">
    <div class="h-[95vh] flex">
      <!-- Left side (Login Form) -->
      <div
        class="lg:w-1/2 flex flex-col justify-center lg:px-24 md:px-14 sm:px-8 px-5 w-full"
      >
        <a href="/">
          <img
            src="assets/green_logo.png"
            alt="logo"
            class="w-[190px] h-[59px] mb-7"
          />
        </a>
        <h1 class="text-[38px] font-semibold text-[#283618] mb-1">Login</h1>
        <p class="text-gray-500 mb-6 text-[16px]">
          Login to access your PanaGhar account
        </p>

        <% if (typeof error !== 'undefined' && error) { %>
  <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-2 rounded mb-4">
    <%= error %>
  </div>
<% } %>


        <!-- ✅ Updated form -->
        <form
          id="loginForm-signin"
          action="/login"
          method="POST"
          class="space-y-4"
        >
          <!-- Email -->
          <div>
            <label class="block text-[16px] mb-1 font-medium text-[#283618]"
              >Email</label
            >
            <input
              id="email-signin"
              type="email"
              name="email"
              placeholder="Enter your Email"
              class="w-full border border-gray-500 rounded px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-[#283618]"
              required
            />
          </div>

          <!-- Password -->
          <div>
            <label class="block text-[16px] font-medium mb-1 text-[#283618]"
              >Password</label
            >
            <div class="relative">
              <input
                id="password-signin"
                type="password"
                name="password"
                placeholder="Enter your Password"
                class="w-full border border-gray-500 rounded px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-[#2C3812]"
                required
              />
              <span
                onclick="togglePassword()"
                class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 cursor-pointer"
              >
                <i
                  id="eye-icon-signin"
                  class="fa-solid fa-eye-slash text-black"
                ></i>
              </span>
            </div>
            <p id="errorMsg-signin" class="text-red-500 text-sm mt-1"></p>
          </div>

          <!-- Remember Me and Forgot -->
          <div
            class="flex justify-between items-center text-[15px] font-[450] text-[#283618]"
          >
            <label class="flex items-center mb-7">
              <input type="checkbox" class="mr-2 text-center" /> Remember me
            </label>
            <a href="#" class="text-[#d69f6f] mb-7">Forgot Password?</a>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            class="w-full bg-[#283618] text-white py-2 rounded hover:bg-[#212419] transition"
          >
            Login
          </button>

          <!-- Signup Link -->
          <p class="text-[16px] text-center text-gray-700">
            Don't have an account?
            <a href="/signup" class="text-[#D9A98F] ml-1 font-semibold"
              >Sign up</a
            >
          </p>

          <!-- Or login with -->
          <div class="flex items-center justify-center pb-6 opacity-50">
            <div class="w-[35%] border-t border-[#88965E]"></div>
            <span class="mx-4 text-[15px] font-semibold text-[#88965E]"
              >Or login with</span
            >
            <div class="w-[35%] border-t border-[#88965E]"></div>
          </div>

          <!-- Social Buttons -->
          <div class="flex justify-between mt-2">
            <a
              href="https://www.facebook.com/"
              target="_blank"
              class="border border-[#807d7d] w-[140px] h-[50px] flex items-center justify-center rounded-md"
            >
              <img
                src="https://upload.wikimedia.org/wikipedia/commons/b/b9/2023_Facebook_icon.svg"
                alt="Facebook"
                class="h-5"
              />
            </a>
            <a
              href="https://accounts.google.com/"
              target="_blank"
              class="border border-[#807d7d] w-[140px] h-[50px] flex items-center justify-center rounded-md"
            >
              <img
                src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/google/google-original.svg"
                alt="Google"
                class="h-5"
              />
            </a>
            <a
              href="https://account.apple.com/sign-in"
              target="_blank"
              class="border border-[#807d7d] w-[140px] h-[50px] flex items-center justify-center rounded-md"
            >
              <img
                src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/apple/apple-original.svg"
                alt="Apple"
                class="h-5"
              />
            </a>
          </div>
        </form>
      </div>

      <!-- Right Side Image -->
      <div class="lg:w-1/2 hidden lg:flex justify-center items-center">
        <img
          src="assets/illustration_login.png"
          alt="Login Illustration"
          class="lg:w-[520px] h-[520px] mt-[105px] mr-[85px]"
        />
      </div>
    </div>

    <!-- Client-side JS -->
    <script>
      function togglePassword() {
        const passwordInput = document.getElementById("password-signin");
        const icon = document.getElementById("eye-icon-signin");

        if (passwordInput.type === "password") {
          passwordInput.type = "text";
          icon.classList.replace("fa-eye-slash", "fa-eye");
        } else {
          passwordInput.type = "password";
          icon.classList.replace("fa-eye", "fa-eye-slash");
        }
      }
    </script>
  </body>
</html>
