<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PanaGhar Login</title>

    <!-- Tailwind & Fonts -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="style.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
      integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter&family=Poppins&display=swap"
      rel="stylesheet"
    />
  </head>

  <body
    class="min-h-[120vh] flex flex-col bg-[#FEFAE0] font-['Inter'] text-white"
  >
    <!-- NAVBAR -->
    <nav class="p-3 flex bg-[#324A16] justify-between items-center">
      <!-- Logo -->
      <a href="/" class="flex items-center flex-1">
        <img
          src="assets/landing_logo.png"
          alt="PanaGhar Logo"
          class="w-[197px] h-[59px] ml-[50px] mb-1.5 object-cover"
        />
      </a>

      <!-- Desktop Menu -->
      <div class="hidden lg:flex gap-[75px]">
        <a href="/" class="font-poppins text-[16px] hover:text-[#b4cb6e]"
          >Home</a
        >
        <a href="/browse" class="font-poppins text-[16px] text-[#b4cb6e]"
          >Browse</a
        >
        <a href="/rental" class="font-poppins text-[16px] hover:text-[#b4cb6e]">
          My Rentals
        </a>
        <a href="/about" class="font-poppins text-[16px] hover:text-[#b4cb6e]"
          >About Us</a
        >
        <a href="/team" class="font-poppins text-[16px] hover:text-[#b4cb6e]"
          >Our Team</a
        >
      </div>

      <!-- Desktop Icons -->
      <div
        class="hidden lg:flex flex-1 justify-end pr-10 gap-[25px] text-lg font-serif"
      >
        <a href="/favourite"
          ><i
            class="fa-regular fa-heart hover:text-[#b4cb6e] cursor-pointer"
          ></i
        ></a>
        <a href="/billing"
          ><i
            class="fa-solid fa-cart-shopping hover:text-[#b4cb6e] cursor-pointer"
          ></i
        ></a>
        <% if (user) { %>
        <a href="/dashboard" class="flex items-center space-x-2">
          <i class="fa-solid fa-user hover:text-[#b4cb6e] cursor-pointer"></i>
          <h2>Welcome, <%= user.firstname %>!</h2>
        </a>
        <% } else { %>
        <i class="fa-solid fa-user hover:text-[#b4cb6e] cursor-pointer"></i>
        <% } %>
      </div>

      <!-- Mobile Menu Button -->
      <button class="p-2 lg:hidden" onclick="handleMenu()">
        <i class="fa-solid fa-bars text-white text-xl"></i>
      </button>

      <!-- Mobile Navigation -->
      <div
        id="nav-dialog"
        class="hidden opacity-0 -translate-y-5 fixed z-10 inset-0 p-3 bg-[#324A16] lg:hidden transition-all duration-300"
      >
        <div class="flex justify-between items-center">
          <img
            src="assets/landing_logo.png"
            alt="PanaGhar Logo"
            class="w-[180px] h-[60px]"
          />
          <button onclick="handleMenu()" class="text-white text-2xl">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>
        <div class="mt-6 flex flex-col space-y-4">
          <a href="/" class="font-poppins text-[16px] hover:text-[#b4cb6e]"
            >Home</a
          >
          <a href="/browse" class="font-poppins text-[16px] text-[#b4cb6e]"
            >Browse</a
          >
          <a
            href="/rental"
            class="font-poppins text-[16px] hover:text-[#b4cb6e]"
          >
            My Rentals
          </a>
          <a href="/about" class="font-poppins text-[16px] hover:text-[#b4cb6e]"
            >About Us</a
          >
          <a href="/team" class="font-poppins text-[16px] hover:text-[#b4cb6e]"
            >Our Team</a
          >
        </div>
      </div>
    </nav>

    <!-- MAIN CONTENT -->
    <main class="flex-grow px-[3.7rem]">
      <!-- Breadcrumb -->
      <section class="pt-[2.4rem] pb-[4rem]">
        <h1 class="text-[22px] font-medium text-[#324A16]">Home / BROWSE</h1>
      </section>

      <!-- Filter + Main Content Wrapper -->
      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Sidebar Filter -->
        <aside
          class="w-full lg:w-[270px] bg-white/10 backdrop-blur-md mt-[20px] rounded-md border border-white/20 text-[#324A16] p-4"
        >
          <h2 class="text-2xl font-semibold mb-4">Filter</h2>

          <!-- Search Bar -->
          <div class="mb-5">
            <label for="search" class="block mb-1">Search by Title</label>
            <input
              type="text"
              id="search"
              placeholder="Enter book title..."
              class="w-full rounded-md p-2 bg-[#FEFAE0] border border-red-100 text-black"
            />
          </div>

          <!-- Availability -->
          <div class="mb-5">
            <label class="block mb-1">Availability</label>
            <select
              id="availability-filter"
              class="w-full rounded-md p-2 bg-[#FEFAE0] border border-red-100 text-black"
            >
              <option value="all">All</option>
              <option value="available">Available</option>
              <option value="rented">Rented</option>
            </select>
          </div>

          <!-- Condition -->
          <div class="mb-5">
            <label class="block mb-1">Condition</label>
            <select
              id="condition-filter"
              class="w-full rounded-md p-2 bg-[#FEFAE0] border border-red-100 text-black"
            >
              <option value="all">All</option>
              <option value="Excellent">Excellent</option>
              <option value="Good">Good</option>
              <option value="Average">Average</option>
              <option value="Bad">Bad</option>
            </select>
          </div>

          <!-- Genre Dropdown -->
          <div class="mb-5">
            <label class="block mb-1">Genre</label>
            <select
              id="genre-filter"
              class="w-full rounded-md p-2 bg-[#FEFAE0] border border-red-100 text-black"
            >
              <option value="all">All</option>
              <option value="Fiction">Fiction</option>
              <option value="Non fiction">Non-fiction</option>
              <option value="Horror">Horror</option>
              <option value="Psychology">Psychology</option>
              <option value="History">History</option>
              <option value="Children">Children</option>
            </select>
          </div>

          <!-- Filter Button -->
          <button
            id="apply-filter"
            class="mt-3 w-full bg-[#b4cb6e] hover:bg-[#9eb75a] text-[#324A16] font-medium py-2 rounded-md transition"
          >
            Apply Filter
          </button>
        </aside>

        <!-- Main Content: Sort + Grid -->
        <section class="flex-grow">
          <!-- Sort Controls -->
          <section class="mb-6 w-full">
            <div
              class="w-full flex flex-col md:flex-row md:items-center md:justify-between mb-6 text-sm lg:text-base text-[#324A16]"
            >
              <!-- Sort by -->
              <div class="flex items-center gap-2 mb-2 md:mb-0">
                <label for="sort" class="whitespace-nowrap font-medium"
                  >Sort by:</label
                >
                <select
                  id="sort"
                  class="bg-[#FEFAE0] border border-red-100 rounded-md px-2 py-1 text-sm text-black"
                >
                  <option selected>Alphabetically, A-Z</option>
                  <option>Alphabetically, Z-A</option>
                  <option>Price: Low to High</option>
                  <option>Price: High to Low</option>
                </select>
              </div>

              <!-- Showing results -->
              <div class="mb-2 md:mb-0">
                Showing
                <span id="showing-from" class="font-semibold">1</span> -
                <span id="showing-to" class="font-semibold">6</span> of
                <span id="total-results" class="font-semibold">18</span> results
              </div>

              <!-- Show per page -->
              <div class="flex items-center gap-2">
                <label for="show" class="whitespace-nowrap font-medium"
                  >Show:</label
                >
                <select
                  id="show"
                  class="bg-[#FEFAE0] border border-red-100 rounded-md px-2 py-1 text-sm text-black"
                >
                  <option value="6" selected>6</option>
                  <option value="9">9</option>
                  <option value="12">12</option>
                  <option value="all">Show All</option>
                </select>
              </div>
            </div>
          </section>

          <!-- Image Grid-->
          <div
            id="product-grid"
            class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 justify-center ml-[120px] mt-[40px]"
          >
            <% if (books && books.length > 0) { %> <% books.forEach(book => { %>
            <a href="/books/<%= book._id %>" class="no-underline">
              <div
                data-genre="<%= book.genre %>"
                data-condition="<%= book.condition %>"
                data-availability="<%= book.status %>"
              >
                <img
                  class="h-[260px] w-[190px] object-cover mb-3 rounded-t-md"
                  src="<%= book.imageUrls && book.imageUrls.length ? book.imageUrls[0] : '/uploads/default-book.png' %>"
                  alt="<%= book.bookName %> book cover"
                />
                <span
                  class="text-black text-[16px] font-medium w-[90%] text-center"
                >
                  <%= book.bookName %> </span
                ><br />
                <span class="text-[#BC6C25] text-[14px] w-[90%] text-center">
                  <%= book.author %> </span
                ><br />
                <span class="text-[#324A16] font-semibold">
                  Rs <%= book.price %>
                </span>
              </div>
            </a>
            <% }) %> <% } else { %>
            <div class="col-span-full text-center mt-10">
              <p class="text-gray-500 text-lg">No books found.</p>
            </div>
            <% } %>
          </div>

          <div
            id="no-results"
            class="hidden text-center text-gray-500 text-lg mt-6"
          >
            No results found.
          </div>
        </section>
      </div>
    </main>

    <!-- FOOTER -->
    <footer class="bg-[#324A16] text-white px-[3.6rem] py-10 mt-16">
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-10">
        <!-- Logo & Tagline -->
        <div>
          <img
            src="assets/landing_logo.png"
            alt="PanaGhar Logo"
            class="h-[70px] w-[200px] mb-2"
          />
          <p class="text-sm text-white/80 leading-relaxed">
            "Where Stories are shared.”
          </p>
        </div>

        <!-- Quick Links -->
        <div>
          <h3 class="font-semibold text-lg mb-3 pt-1">Quick Links</h3>
          <ul class="space-y-2 text-white/80">
            <li><a href="#" class="hover:text-white transition">Home</a></li>
            <li><a href="#" class="hover:text-white transition">About</a></li>
            <li><a href="#" class="hover:text-white transition">Contact</a></li>
          </ul>
        </div>

        <!-- Contact Info -->
        <div>
          <h3 class="font-semibold text-lg mb-3 pt-1">Contact</h3>
          <ul class="space-y-2 text-white/80">
            <li>
              Email:
              <a
                href="mailto:panaghar@gmail.com"
                class="hover:text-white transition"
                >panaghar@gmail.com</a
              >
            </li>
            <li>Phone: +977-123456789</li>
            <li>Location: GCES,Lamachaur</li>
          </ul>
        </div>

        <!-- Payment Methods -->
        <div class="pl-[3rem]">
          <h3 class="font-semibold text-lg mb-3 pt-1">We Accept</h3>
          <div class="flex items-center space-x-4">
            <img src="assets/Visa.png" alt="Visa" class="h-6 w-auto" />
            <img
              src="assets/Mastercard.png"
              alt="Mastercard"
              class="h-6 w-auto"
            />
            <img
              src="assets/American Express.png"
              alt="American Express"
              class="h-6 w-auto"
            />
          </div>
        </div>
      </div>

      <div
        class="w-full border-t border-dashed border-white opacity-50 my-10"
      ></div>

      <p class="text-center text-sm md:text-base text-white/80">
        © 2025 <span class="font-semibold text-white">PanaGhar</span>. All
        rights reserved.
      </p>
    </footer>

    <script src="script.js"></script>
   <script>
document.addEventListener("DOMContentLoaded", function () {
  const productGrid = document.getElementById("product-grid");
  const allProducts = Array.from(productGrid.querySelectorAll("a")); // Original products
  const totalResultsEl = document.getElementById("total-results");
  const showingFromEl = document.getElementById("showing-from");
  const showingToEl = document.getElementById("showing-to");
  const sortSelect = document.getElementById("sort");
  const showSelect = document.getElementById("show");
  const searchInput = document.getElementById("search");
  const genreSelect = document.getElementById("genre-filter");
  const conditionSelect = document.getElementById("condition-filter");
  const availabilitySelect = document.getElementById("availability-filter");
  const applyBtn = document.getElementById("apply-filter");
  const noResultsEl = document.getElementById("no-results");

  let filteredProducts = [...allProducts];

  // ========== FILTER FUNCTION ==========
  function applyFilters() {
    const searchTerm = searchInput.value.toLowerCase().trim();
    const selectedGenre = genreSelect.value.toLowerCase();
    const selectedCondition = conditionSelect.value.toLowerCase();
    const selectedAvailability = availabilitySelect.value.toLowerCase();

    filteredProducts = allProducts.filter(link => {
      const bookDiv = link.querySelector("div");
      const title = bookDiv.querySelector("span.text-black")?.textContent.toLowerCase() || "";
      const author = bookDiv.querySelector("span.text-\\[\\#BC6C25\\]")?.textContent.toLowerCase() || "";
      
      // Get and normalize data attributes
      const genre = (bookDiv.dataset.genre || "").toLowerCase().trim();
      const condition = (bookDiv.dataset.condition || "").toLowerCase().trim();
      const availability = (bookDiv.dataset.availability || "available").toLowerCase().trim();

      // Match logic
      const matchesSearch = searchTerm === "" || title.includes(searchTerm) || author.includes(searchTerm);
      const matchesGenre = selectedGenre === "all" || genre === selectedGenre;
      const matchesCondition = selectedCondition === "all" || condition === selectedCondition;
      const matchesAvailability = selectedAvailability === "all" || availability === selectedAvailability;

      return matchesSearch && matchesGenre && matchesCondition && matchesAvailability;
    });

    sortProducts(sortSelect.value); // sort after filtering
  }

  // ========== SORT FUNCTION ==========
  function sortProducts(method) {
    filteredProducts.sort((a, b) => {
      const bookA = a.querySelector("div");
      const bookB = b.querySelector("div");

      const titleA = bookA.querySelector("span.text-black")?.textContent || "";
      const titleB = bookB.querySelector("span.text-black")?.textContent || "";
      const priceA = parseFloat(bookA.querySelector("span.text-\\[\\#324A16\\]")?.textContent.replace("Rs ", "") || 0);
      const priceB = parseFloat(bookB.querySelector("span.text-\\[\\#324A16\\]")?.textContent.replace("Rs ", "") || 0);

      switch (method) {
        case "Alphabetically, A-Z":
          return titleA.toLowerCase().localeCompare(titleB.toLowerCase());
        case "Alphabetically, Z-A":
          return titleB.toLowerCase().localeCompare(titleA.toLowerCase());
        case "Price: Low to High":
          return priceA - priceB;
        case "Price: High to Low":
          return priceB - priceA;
        default:
          return 0;
      }
    });

    renderProducts();
  }

  // ========== RENDER PRODUCTS ==========
  function renderProducts() {
    productGrid.innerHTML = "";
    const showCount = showSelect.value === "all" ? filteredProducts.length : parseInt(showSelect.value);
    let visibleCount = 0;

    filteredProducts.forEach((link, index) => {
      if (index < showCount) {
        productGrid.appendChild(link);
        visibleCount++;
      }
    });

    showingFromEl.textContent = visibleCount === 0 ? 0 : 1;
    showingToEl.textContent = visibleCount;
    totalResultsEl.textContent = filteredProducts.length;
    noResultsEl.classList.toggle("hidden", visibleCount > 0);
  }

  // ========== EVENT LISTENERS ==========
  applyBtn.addEventListener("click", applyFilters);
  searchInput.addEventListener("input", applyFilters);
  sortSelect.addEventListener("change", () => sortProducts(sortSelect.value));
  showSelect.addEventListener("change", renderProducts);

  // ========== INITIAL LOAD ==========
  applyFilters();
});
</script>


  </body>
</html>
